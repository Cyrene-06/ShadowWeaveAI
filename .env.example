# 配置参考；API 读取进程环境，不自动加载此文件。PowerShell 见 docs/development.md。
APP_ENV=development
DATABASE_URL=sqlite:///artifacts/phase-one.sqlite3
ARTIFACT_DIR=artifacts
# 仅开发回放显式启用；production 下禁止为 true。
ENABLE_PHASE_ONE_REPLAY=false
# 开发默认在 artifacts/ 下生成随机密钥；生产必须配置至少 32 字符。
JWT_SECRET=
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# 以下两项可留空并使用 PATH / 本地工具发现。
FFMPEG_PATH=
FFPROBE_PATH=
# Flutter 编译参数，非 API 环境变量：--dart-define=API_BASE_URL=...
# 模型协议探针配置；仅 scripts/model_probe.py --execute 显式发起一次请求。
# MODEL_PROVIDER 支持 openai 或 openai_compatible；BASE_URL 为 API 根地址，通常以 /v1 结束。
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
REDIS_URL=
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
