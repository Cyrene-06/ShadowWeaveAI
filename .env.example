# 计划环境变量；当前尚无应用读取此文件。
# 初始化服务时明确加载方式、必填项、默认值和校验，并同步服务文档。
# 不填写真实密钥到此模板；后续使用的本地 .env 已由 Git 忽略。

# 业务运行配置：环境名称和日志级别
APP_ENV=development
LOG_LEVEL=INFO

# 持久化与任务；待本地基础设施确定后填写完整连接地址
DATABASE_URL=
REDIS_URL=

# S3 兼容对象存储：端点、区域、桶与服务端访问凭据
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 模型适配器；变量设计会随实际供应商接入完善
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# 外部媒体工具；应用初始化后验证其存在与构建能力
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
