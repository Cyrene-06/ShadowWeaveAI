{
  "name": "shadowweave-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run tests/contracts.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e *.ts *.json",
    "format:check": "prettier --check src tests e2e *.ts *.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.0.0"
  }
}
